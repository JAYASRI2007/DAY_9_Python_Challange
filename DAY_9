import copy

def create_inventory():
    inventory = [
        {
            "item": "Laptop",
            "details": {
                "price": 50000,
                "stock": 10,
                "supplier": {"rating": 4.5}
            }
        },
        {
            "item": "Phone",
            "details": {
                "price": 20000,
                "stock": 25,
                "supplier": {"rating": 4.2}
            }
        },
        {
            "item": "Tablet",
            "details": {
                "price": 30000,
                "stock": 15,
                "supplier": {"rating": 4.0}
            }
        }
    ]
    return inventory


def apply_discount(data, roll_number):
    length = len(data)
    index_to_modify = roll_number % length

    for i in range(len(data)):
        # Apply 10% discount
        old_price = data[i]["details"]["price"]
        data[i]["details"]["price"] = int(old_price * 0.9)

        # Custom mutation rule (ONLY one index)
        if i == index_to_modify:
            data[i]["details"]["stock"] += 5

    return data

def compare_data(original, modified):
    changed = 0
    unchanged = 0

    for i in range(len(original)):
        if original[i] != modified[i]:
            changed += 1
        else:
            unchanged += 1

    return (changed, unchanged)

def main():
    roll_number = 23  
    original_inventory = create_inventory()
    shallow_copy_inventory = original_inventory.copy()
    deep_copy_inventory = copy.deepcopy(original_inventory)
    apply_discount(shallow_copy_inventory, roll_number)
    apply_discount(deep_copy_inventory, roll_number)
    shallow_result = compare_data(original_inventory, shallow_copy_inventory)
    deep_result = compare_data(original_inventory, deep_copy_inventory)
    print("\n--- ORIGINAL INVENTORY ---")
    print(original_inventory)

    print("\n--- SHALLOW COPY INVENTORY ---")
    print(shallow_copy_inventory)

    print("\n--- DEEP COPY INVENTORY ---")
    print(deep_copy_inventory)

    print("\n--- COMPARISON ---")
    print("Shallow Copy Changes (changed, unchanged):", shallow_result)
    print("Deep Copy Changes (changed, unchanged):", deep_result)

    print("\n--- MEMORY PROOF ---")
    print("Shallow shares nested object?:",
          original_inventory[0]["details"] is shallow_copy_inventory[0]["details"])

    print("Deep shares nested object?:",
          original_inventory[0]["details"] is deep_copy_inventory[0]["details"])

    print("\n--- EXPLANATION ---")
    print("Shallow copy copies only outer list, but inner dictionaries are shared.")
    print("So modifying price/stock in shallow copy ALSO changes original data.")
    print("This is proven above where shallow shows TRUE (same memory).")

    print("Deep copy creates completely independent nested objects.")
    print("So modifying deep copy does NOT affect original.")
    print("This is proven above where deep shows FALSE (different memory).")

if __name__ == "__main__":
    main()